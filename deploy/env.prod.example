# ---------------------------------------------------------------
# PNPI — Production environment variables
# Copy to .env.prod and fill in real values before deploying.
# ---------------------------------------------------------------

# --- PostgreSQL ---
POSTGRES_DB=pnpi
POSTGRES_USER=pnpi_user
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password_here

# --- Backend / FastAPI ---
PNPI_SECRET_KEY=CHANGE_ME_generate_with_openssl_rand_hex_64
PNPI_ENV=production
PNPI_DATABASE_URL=postgresql://pnpi_user:CHANGE_ME@postgres:5432/pnpi

# --- Role passwords (must comply with password policy: 12+ chars, upper, lower, digit, special) ---
PNPI_ADMIN_PASSWORD=CHANGE_ME_Admin!Str0ng
PNPI_MINISTRE_PASSWORD=CHANGE_ME_Ministre!Str0ng
PNPI_DIRECTEUR_PASSWORD=CHANGE_ME_Directeur!Str0ng
PNPI_INSTRUCTEUR_PASSWORD=CHANGE_ME_Instructeur!Str0ng
PNPI_INSPECTEUR_PASSWORD=CHANGE_ME_Inspecteur!Str0ng
PNPI_OPERATEUR_PASSWORD=CHANGE_ME_Operateur!Str0ng

# --- Frontend / Next.js ---
NEXT_PUBLIC_BACKEND_URL=http://backend:8000
PNPI_BACKEND_USERNAME=ministre
PNPI_BACKEND_PASSWORD=CHANGE_ME_Ministre!Str0ng

# --- CORS (comma-separated origins allowed in production) ---
PNPI_CORS_ALLOW_ORIGINS=https://pnpi.gouv.ga

# --- SSL certificate paths (mounted into nginx container) ---
SSL_CERT_PATH=/etc/letsencrypt/live/pnpi.gouv.ga

# --- Docker image registry ---
GHCR_OWNER=your-github-org
IMAGE_TAG=latest

# --- Rate limiting ---
PNPI_RATE_LIMIT_WINDOW_SECONDS=60
PNPI_AUTH_RATE_LIMIT_MAX_REQUESTS=10
PNPI_SENSITIVE_RATE_LIMIT_MAX_REQUESTS=30

# --- SLA thresholds (days) ---
PNPI_SLA_LOW_DAYS=45
PNPI_SLA_MEDIUM_DAYS=30
PNPI_SLA_HIGH_DAYS=21

# --- Alerts ---
PNPI_ALERT_WEBHOOK_URL=
PNPI_ALERT_OVERDUE_DOSSIERS_THRESHOLD=50
PNPI_ALERT_UNREAD_CRITICAL_THRESHOLD=10
PNPI_ALERT_ERROR_RATE_THRESHOLD=0.1

# --- Token expiration ---
PNPI_REFRESH_TOKEN_EXPIRE_DAYS=7

# --- SMTP (Email Notifications) ---
PNPI_SMTP_HOST=smtp.example.com
PNPI_SMTP_PORT=587
PNPI_SMTP_USER=pnpi@example.com
PNPI_SMTP_PASSWORD=your-smtp-password
PNPI_SMTP_FROM=noreply@pnpi-gabon.ga
