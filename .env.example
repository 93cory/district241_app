# ─── PostgreSQL ───────────────────────────────────────────
POSTGRES_DB=pnpi
POSTGRES_USER=pnpi_user
POSTGRES_PASSWORD=change-me-strong-password

# ─── Redis (cache + rate limiter) ─────────────────────────
PNPI_REDIS_PASSWORD=change-me-strong-redis-password

# ─── Backend ─────────────────────────────────────────────
PNPI_SECRET_KEY=change-me-generate-with-openssl-rand-hex-32
PNPI_ADMIN_PASSWORD=change-me-admin
PNPI_MINISTRE_PASSWORD=change-me-ministre
PNPI_OPERATEUR_PASSWORD=change-me-operateur
PNPI_INSPECTEUR_PASSWORD=change-me-inspecteur
PNPI_ENV=development

# ─── Frontend ────────────────────────────────────────────
NEXT_PUBLIC_BACKEND_URL=http://backend:8000
PNPI_BACKEND_USERNAME=ministre
PNPI_BACKEND_PASSWORD=change-me-ministre
