# ─── PostgreSQL ───────────────────────────────────────────
POSTGRES_DB=pnpi
POSTGRES_USER=pnpi_user
POSTGRES_PASSWORD=change-me-strong-password

# ─── Redis (cache + rate limiter) ─────────────────────────
PNPI_REDIS_PASSWORD=change-me-strong-redis-password

# ─── S3 / MinIO (sauvegardes DB + stockage documents) ─────
# Memes identifiants pour scripts/backup_s3.py (bucket PNPI_S3_BUCKET) et le
# stockage documents/photos (bucket PNPI_S3_DOCUMENTS_BUCKET) — cf
# core/storage.py. PNPI_STORAGE_BACKEND=local (defaut, aucune config requise)
# ou =s3 pour activer le stockage objet des documents ATI / photos.
PNPI_S3_ACCESS_KEY=pnpi_minio
PNPI_S3_SECRET_KEY=change-me-strong-minio-secret
# PNPI_STORAGE_BACKEND=s3
# PNPI_S3_ENDPOINT=http://minio:9000
# PNPI_S3_DOCUMENTS_BUCKET=pnpi-documents

# ─── Vault (secrets, optionnel — dette D-012) ─────────────
# Si defini, PNPI_SECRET_KEY et PNPI_FIELD_ENCRYPTION_KEY sont lus depuis
# Vault en priorite (cf core/secrets.py). Laisser vide = variables d'env
# classiques (comportement historique).
# PNPI_VAULT_ADDR=http://vault:8200
# PNPI_VAULT_TOKEN=change-me-vault-token

# ─── Monitoring d'erreurs (optionnel — dette D-009) ───────
# DSN d'un service compatible protocole Sentry : Sentry.io (SaaS) ou
# Glitchtip (self-hosted, cf https://glitchtip.com/documentation/install).
# Le code (core/error_tracking.py) est backend-agnostique : n'importe quel
# service parlant le protocole Sentry fonctionne, aucune config
# supplementaire cote PNPI. Laisser vide = pas de monitoring centralise
# (comportement historique : logs JSON uniquement).
# PNPI_SENTRY_DSN=https://<key>@<host>/<project_id>

# ─── Backend ─────────────────────────────────────────────
PNPI_SECRET_KEY=change-me-generate-with-openssl-rand-hex-32
PNPI_ADMIN_PASSWORD=change-me-admin
PNPI_MINISTRE_PASSWORD=change-me-ministre
PNPI_OPERATEUR_PASSWORD=change-me-operateur
PNPI_INSPECTEUR_PASSWORD=change-me-inspecteur
PNPI_ENV=development

# ─── Frontend ────────────────────────────────────────────
NEXT_PUBLIC_BACKEND_URL=http://backend:8000
PNPI_BACKEND_USERNAME=ministre
PNPI_BACKEND_PASSWORD=change-me-ministre
